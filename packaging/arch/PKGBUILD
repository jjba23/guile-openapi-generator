# guile-openapi-generator - OpenAPI 3 to Guile Scheme code generator
#
# SPDX-License-Identifier: MIT
# Copyright © Josep Bigorra <jjbigorra@gmail.com>

# Maintainer: Josep Bigorra <jjbigorra@gmail.com>
pkgname=guile-openapi-generator
pkgver=0.1.0
pkgrel=1
pkgdesc="OpenAPI 3 to Guile Scheme code generator"
arch=('any')
url="https://codeberg.org/jjba23/guile-openapi-generator"
license=('MIT')

depends=(
  'guile'
  'guile-json'
)

makedepends=(
  'guile'
  'pkgconf'
)

# The suite is one runner over every Veritas spec, so it needs Veritas itself;
# the libcurl transport test needs guile-curl and skips cleanly without it.
checkdepends=(
  'veritas'
  'guile-curl'
)

optdepends=(
  'guile-curl: generated libcurl clients'
  'artanis: generated Artanis controller adapters'
)

source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
# This recipe tracks the version in the tree.  The tag and its tarball are cut
# from that tree, so the checksum is filled in with `updpkgsums' when the tag is
# published; packaging/README.org describes the release steps.
sha256sums=('SKIP')

# veritas is produced by the same packaging batch; build it first.

# Guile looks for byte-compiled modules under the site-ccache directory,
# which differs between distributions, so ask Guile's pkg-config file
# instead of hard-coding a path.
_site_dir() {
  pkg-config --variable=sitedir guile-3.0 2>/dev/null \
    || echo /usr/share/guile/site/3.0
}

_compiled_dir() {
  pkg-config --variable=siteccachedir guile-3.0 2>/dev/null \
    || echo /usr/lib/guile/3.0/site-ccache
}

check() {
  cd "$srcdir/guile-openapi-generator"

  # The suites read the fixtures and write their generated trees relative to
  # the sources, so they run from the checkout rather than from a copy.
  VERITAS_TEST_MODULE=veritas \
    VERITAS_TEST_TOP_DIR=test \
    VERITAS_TEST_TYPE=unit \
    VERITAS_RUN_BENCHMARKS=false \
    guile -L ./src -L ./test -c '(exit ((@ (veritas runner) run-tests)))'
}

package() {
  cd "$srcdir/guile-openapi-generator"

  # The layout — launcher, manual page, modules and their byte-compiled
  # copies — comes from the installer every recipe and the container share,
  # so this package cannot drift from the Debian, openSUSE or container one.
  # The two directories are passed explicitly because pkg-config's answer is
  # the one this distribution's Guile looks at, and the installer would
  # otherwise ask the interpreter it finds on PATH.
  sh scripts/install-tree --destdir "$pkgdir" \
    --site-dir "$(_site_dir)" \
    --ccache-dir "$(_compiled_dir)"

  # Licences and documentation are this recipe's business, so they follow
  # Arch's own conventions rather than the installer's prefix/share/doc.
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.org "$pkgdir/usr/share/doc/$pkgname/README.org"
}
