#!/usr/bin/make -f

export DH_VERBOSE = 1

# The installed layout is described once, in scripts/install-tree, and every
# recipe here runs that script instead of repeating it.  Debian's site-ccache
# lives in the multiarch libdir, which is one of the reasons the script asks
# Guile for the directory rather than taking a path from the recipe.
STAGE = build/root

%:
	dh $@

# Guile's .go files are ELF objects whose debug sections dwz does
# not understand; there is no separate debug binary to compress.
override_dh_dwz:

override_dh_auto_configure:
	# Nothing to configure: Scheme sources plus a bash launcher.

# The build stage produces the tree the package will hold: the launcher, the
# manual page, the modules and their byte-compiled copies, all at the paths
# Guile reports for this distribution and architecture.  It is also what
# `maak package-smoke' installs into a scratch root, so a wrong layout fails
# before a package is uploaded rather than after it is installed.
override_dh_auto_build:
	sh scripts/install-tree --destdir $(STAGE) --prefix /usr

override_dh_auto_test:
	# The libcurl transport test skips itself when guile-curl is not
	# installed, so the build does not depend on an optional transport.
	VERITAS_TEST_MODULE=veritas \
	VERITAS_TEST_TOP_DIR=test \
	VERITAS_TEST_TYPE=unit \
	VERITAS_RUN_BENCHMARKS=false \
	guile -L ./src -L ./test -c '(exit ((@ (veritas runner) run-tests)))'

override_dh_auto_install:
	cp -a $(STAGE)/. debian/guile-openapi-generator/

override_dh_auto_clean:
	rm -rf build
	dh_auto_clean
