{
  "openapi": "3.0.3",
  "info": { "title": "Mini", "version": "1.0.0" },
  "paths": {
    "/things": {
      "get": {
        "operationId": "listThings",
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Thing" }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Thing": {
        "type": "object",
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "label": { "type": "string" },
          "notes": { "type": "string", "nullable": true }
        }
      }
    }
  }
}
