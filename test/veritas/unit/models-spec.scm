;;; Commentary:
;;
;; The models generator.  Half of the suite reads the generated text, because a
;; generated file is also documentation and the names in it matter; the other
;; half writes the tree to a directory, loads it, and uses the records the way a
;; caller would: construct, validate, serialise, patch, decode a union.
;;
;; Every behaviour test goes through @code{with-models}, which generates the
;; polymorphic fixture under a module root of its own, loads it, and hands the
;; test the interface of the models module.

(define-module (veritas unit models-spec)
  #:declarative? #t
  #:use-module (veritas veritas)
  #:use-module (ice-9 format)
  #:use-module (srfi srfi-1)
  #:use-module (srfi srfi-13)
  #:use-module (ice-9 string-fun)
  #:use-module (openapi-generator jso)
  #:use-module (openapi-generator models)
  #:use-module (openapi-support)
  #:export (spec))

;;; Helpers

(define petstore-text
  (emit-models (petstore-spec) (test-config #:root "petstore")))

(define polymorphic-text
  (emit-models (polymorphism-spec) (test-config #:root "polymorphic")))

(define* (check-models root program)
  "Generate the polymorphic fixture as ROOT and run the fixture program PROGRAM."
  (with-generated root
    (lambda (directory)
      (run-program directory (list (list root 'models)) program))
    #:input (fixture "polymorphism.yaml")))

(define (lines output)
  "Return the non-empty lines of OUTPUT, trimmed."
  (filter (lambda (line)
            (not (string-null? line)))
          (map string-trim-both (string-split output #\newline))))

(define (invalid? thunk)
  "Return @code{(path message)} when @var{thunk} throws a validation error."
  (catch 'openapi-validation-error
    (lambda ()
      (thunk)
      #f)
    (lambda (key path message)
      (list path message))))

;;; Suites

(define text-suite
  (suite "Generated text"
         (test "A record is a record, a constructor and a predicate"
               (assert-true (contains? petstore-text "(define-record-type <pet>"))
               (assert-true (contains? petstore-text
                                       "(define* (make-pet #:key (id #f) (name #f)"))
               (assert-true (contains? petstore-text "(define (pet-valid? value)"))
               (assert-true (contains? petstore-text "(id pet-id)"))
               (assert-true (contains? petstore-text "(name pet-name)")))

         (test "The constructor validates what the specification declares"
               (assert-true (contains? petstore-text
                                       "(check-required '(\"pet\" \"name\")"))
               (assert-true (contains? petstore-text
                                       "(check-min-length '(\"pet\" \"name\")"))
               (assert-true (contains? petstore-text "pet-status-values")))

         (test "The converters are generated and named after the schema"
               (assert-true (contains? petstore-text "(define (pet->jso value)"))
               (assert-true (contains? petstore-text "(define (jso->pet node)"))
               (assert-true (contains? petstore-text
                                       "(define* (pet-apply-patch value patch)")))

         (test "An enumeration becomes values and constants"
               ;; A definition always breaks: the values are on the line below
               ;; the name they are bound to.
               (assert-true
                (contains? petstore-text
                           (string-append "(define pet-status-values\n"
                                          "  (list \"available\" \"pending\" \"sold\"))")))
               (assert-true (contains? petstore-text
                                       (string-append "(define pet-status-available\n"
                                                      "  \"available\")")))
               (assert-true (contains? petstore-text
                                       "(define (pet-status? value)")))

         (test "The docstring says where the file came from"
               (assert-true (contains? petstore-text
                                       "Generated by guile-openapi-generator"))
               (assert-true (contains? petstore-text "from the Petstore")))

         (test "Composition is flattened into one record"
               (assert-true (contains? polymorphic-text
                                       "(define-record-type <cat>"))
               (assert-true (contains? polymorphic-text "(name cat-name)"))
               (assert-true (contains? polymorphic-text "(indoor cat-indoor)")))

         (test "A union is a predicate and a decoder that uses the discriminator"
               (assert-true (contains? polymorphic-text
                                       "(define (animal? value)"))
               (assert-true (contains? polymorphic-text
                                       "(string=? (jso-ref node \"kind\") \"cat\")")))

         (test "An object of only additionalProperties is a map"
               (assert-true (contains? polymorphic-text
                                       "(define (string-map? value)"))
               (assert-true (contains? polymorphic-text "(every pair? value)")))

         (test "A nullable member is written as null"
               (assert-true
                (contains? polymorphic-text "(cons \"nickname\""))
               (assert-true
                (contains? polymorphic-text
                           "(if (eq? (cat-nickname value) #f)"))
               (assert-true
                (contains? polymorphic-text "json-null")))

         (test "An absent optional member is left out"
               (assert-true (contains? polymorphic-text
                                       "(if (eq? (dog-breed value) #f)")))))

(define behaviour-suite
  (suite "Generated records"
         #:concurrent? #f

         (test "A record is constructed, read and validated"
               (assert-equal #:expect '("cat" "Mia" "#t" "9" "#t" "#t")
                             #:got (lines (check-models 'e2e-models
                                                        "models-construct"))))

         (test "A missing required member raises with the path of the field"
               (assert-equal #:expect '("((cat name) is required but is missing)")
                             #:got (lines (check-models 'e2e-models-required
                                                        "models-required"))))

         (test "A value outside the constraints raises"
               (assert-equal #:expect '("(dog name)" "Rex")
                             #:got (lines (check-models 'e2e-models-constraints
                                                        "models-constraints"))))

         (test "An enumeration is values, constants and a predicate"
               (assert-equal #:expect '("fresh" "#t" "(fish water)")
                             #:got (lines (check-models 'e2e-models-enum
                                                        "models-enum"))))

         (test "A record serialises to jso and back"
               (assert-equal #:expect '("Mia" "#t" "#t" "#f" "Mia" "Mia")
                             #:got (lines (check-models 'e2e-models-json
                                                        "models-json"))))

         (test "A required member that accepts null may be #f"
               (assert-equal
                #:expect '("null" "null" "#f" "#f" "w")
                #:got
                (lines
                 (with-generated 'e2e-nullable-required
                   (lambda (directory)
                     (run-program directory
                                  (list '(e2e-nullable-required models))
                                  "nullable-required"))
                   #:input (fixture "nullable-required.yaml")
                   #:controllers 'none
                   #:http 'none))))

         (test "A merge patch replaces and removes members"
               (assert-equal #:expect '("Tom" "#f")
                             #:got (lines (check-models 'e2e-models-patch
                                                        "models-patch"))))

         (test "A discriminated union decodes into the right record"
               (assert-equal #:expect '("#t" "Mia" "#t" "#t" "#t" "#f" "(Animal)")
                             #:got (lines (check-models 'e2e-models-union
                                                        "models-union"))))

         (test "Named scalars, lists and maps validate through their predicates"
               (assert-equal #:expect '("#t" "#f" "#t" "#f" "#(a b)" "#t" "()")
                             #:got (lines (check-models 'e2e-models-scalars
                                                        "models-scalars"))))))

(define (spec)
  (veritas-run #:concurrent? #f
               text-suite behaviour-suite))
