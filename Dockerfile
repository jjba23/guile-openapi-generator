# syntax=docker/dockerfile:1.7

# guile-openapi-generator
#
# Generated by gen_containers.py; keep in step with packaging/.

FROM opensuse/tumbleweed:latest AS builder

ARG VERSION=dev

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

WORKDIR /src

RUN --mount=type=cache,target=/var/cache/zypp \
    set -eu; \
    zypper --non-interactive refresh; \
    zypper --non-interactive install --no-recommends guile; \
    zypper clean --all

COPY src/openapi-generator ./src/openapi-generator
COPY src/openapi-generator.scm ./src/openapi-generator.scm

RUN set -eu; \
    site="/usr/share/guile/site/3.0"; \
    install -d "$site/openapi-generator"; \
    cp -r "src/openapi-generator/." "$site/openapi-generator/"; \
    cp "src/openapi-generator.scm" "$site/openapi-generator.scm"

# ----------------------------------------------------------------------
# Runtime
# ----------------------------------------------------------------------

FROM opensuse/tumbleweed:latest AS runtime

ARG VERSION=dev

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

LABEL org.opencontainers.image.title="guile-openapi-generator" \
      org.opencontainers.image.description="OpenAPI 3 to Guile Scheme code generator" \
      org.opencontainers.image.url="https://codeberg.org/jjba23/guile-openapi-generator" \
      org.opencontainers.image.licenses="AGPL-3.0-or-later" \
      org.opencontainers.image.version="${VERSION}"

RUN --mount=type=cache,target=/var/cache/zypp \
    set -eu; \
    zypper --non-interactive refresh; \
    zypper --non-interactive install --no-recommends \
        guile \
        ca-certificates \
        guile-json; \
    zypper clean --all

COPY --from=builder /usr/share/guile/site/3.0/openapi-generator /usr/share/guile/site/3.0/openapi-generator
COPY --from=builder /usr/share/guile/site/3.0/openapi-generator.scm /usr/share/guile/site/3.0/openapi-generator.scm

ENTRYPOINT ["guile"]
